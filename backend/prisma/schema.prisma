generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(COMMUNITY_USER)
  language     String        @default("en")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  fieldReports FieldReport[]

  @@index([role])
}

model NerState {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  createdAt DateTime   @default(now())
  locations Location[]
}

model Location {
  id                    String                     @id @default(uuid())
  name                  String
  stateId               String
  district              String
  latitude              Float
  longitude             Float
  elevation             Float                      @default(0.0)
  location              Unsupported("geometry")?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  alerts                Alert[]
  fieldReports          FieldReport[]
  historicalEvents      HistoricalLandslideEvent[]
  incidents             Incident[]
  infrastructure        Infrastructure[]
  state                 NerState                   @relation(fields: [stateId], references: [id], onDelete: Cascade)
  predictions           Prediction[]
  riskZones             RiskZone[]
  satelliteObservations SatelliteObservation[]
  sensors               Sensor[]
  weatherReadings       WeatherReading[]

  @@index([stateId])
  @@index([district])
}

model RiskZone {
  id                       String                   @id @default(uuid())
  locationId               String
  riskScore                Int
  riskLevel                RiskLevel
  confidence               Float
  rainfallContribution     Float
  soilMoistureContribution Float
  slopeContribution        Float
  terrainContribution      Float
  historicalContribution   Float
  displacementContribution Float
  status                   String                   @default("ACTIVE")
  geometry                 Unsupported("geometry")?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  location                 Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([riskLevel])
  @@index([riskScore])
  @@index([status])
}

model Sensor {
  id           String                   @id @default(uuid())
  stationCode  String                   @unique
  stationName  String
  locationId   String
  sensorType   SensorType
  status       SensorStatus             @default(ONLINE)
  unit         String
  currentValue Float                    @default(0.0)
  batteryLevel Float                    @default(100.0)
  lastUpdated  DateTime                 @default(now())
  locationGeom Unsupported("geometry")?
  createdAt    DateTime                 @default(now())
  location     Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)
  readings     SensorReading[]

  @@index([locationId])
  @@index([sensorType])
  @@index([status])
}

model SensorReading {
  id        String   @id @default(uuid())
  sensorId  String
  value     Float
  unit      String
  timestamp DateTime @default(now())
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  @@index([sensorId, timestamp])
  @@index([timestamp])
}

model WeatherReading {
  id               String   @id @default(uuid())
  locationId       String
  rainfall         Float
  humidity         Float
  temperature      Float
  windSpeed        Float
  soilMoisture     Float
  forecastRainfall Float
  timestamp        DateTime @default(now())
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, timestamp])
  @@index([timestamp])
}

model SatelliteObservation {
  id              String           @id @default(uuid())
  locationId      String
  provider        String           @default("DEMO")
  observationType SatelliteObsType
  displacement    Float
  terrainChange   Boolean          @default(false)
  imageUrl        String?
  observationTime DateTime         @default(now())
  createdAt       DateTime         @default(now())
  location        Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([observationType])
}

model Incident {
  id           String                   @id @default(uuid())
  title        String
  description  String
  locationId   String
  latitude     Float
  longitude    Float
  locationGeom Unsupported("geometry")?
  severity     Severity                 @default(HIGH)
  status       IncidentStatus           @default(OPEN)
  assignedTeam String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  location     Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([severity])
  @@index([status])
}

model FieldReport {
  id                   String                   @id @default(uuid())
  clientReportId       String                   @unique
  userId               String?
  locationId           String?
  latitude             Float
  longitude            Float
  locationGeom         Unsupported("geometry")?
  accuracy             Float                    @default(10.0)
  description          String
  verificationStatus   VerificationStatus       @default(PENDING)
  aiConfidence         Float?                   @default(0.0)
  offlineCreated       Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  aiVerificationStatus AiVerificationStatus     @default(NOT_PROCESSED)
  observedAt           DateTime                 @default(now())
  reportType           FieldReportType          @default(LANDSLIDE)
  reporterName         String?
  reporterRole         UserRole?
  severity             Severity                 @default(MODERATE)
  source               String                   @default("FIELD_REPORT")
  status               FieldReportStatus        @default(RECEIVED)
  syncStatus           SyncStatus               @default(SYNCED)
  location             Location?                @relation(fields: [locationId], references: [id])
  user                 User?                    @relation(fields: [userId], references: [id])
  media                FieldReportMedia[]

  @@index([locationId])
  @@index([observedAt])
  @@index([severity])
  @@index([status])
  @@index([verificationStatus])
  @@index([clientReportId])
}

model FieldReportMedia {
  id          String      @id @default(uuid())
  reportId    String
  mediaType   MediaType
  fileName    String
  mimeType    String
  fileSize    Int
  storagePath String?
  publicUrl   String?
  checksum    String?
  uploadedAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())
  report      FieldReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([mediaType])
}

model Alert {
  id                     String           @id @default(uuid())
  title                  String
  message                String
  locationId             String?
  status                 AlertStatus      @default(ACTIVE)
  createdAt              DateTime         @default(now())
  acknowledgedAt         DateTime?
  affectedInfrastructure Json?
  affectedPopulation     Int?
  alertCode              String           @unique
  alertLevel             AlertLevel       @default(ADVISORY)
  confidence             Float?
  expiresAt              DateTime?
  generatedAt            DateTime         @default(now())
  incidentId             String?
  predictionProbability  Float?
  priority               AlertPriority    @default(P4)
  recommendedAction      String
  resolvedAt             DateTime?
  riskScore              Float?
  riskZoneId             String?
  source                 AlertSource      @default(SYSTEM)
  triggerType            AlertTriggerType @default(RISK_THRESHOLD)
  updatedAt              DateTime         @updatedAt
  location               Location?        @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([alertLevel])
  @@index([priority])
  @@index([status])
  @@index([generatedAt])
  @@index([expiresAt])
}

model HistoricalLandslideEvent {
  id                 String                   @id @default(uuid())
  locationId         String?
  latitude           Float
  longitude          Float
  locationGeom       Unsupported("geometry")?
  eventDate          DateTime
  severity           Severity                 @default(HIGH)
  rainfall24h        Float?
  rainfall72h        Float?
  soilMoisture       Float?
  slope              Float?
  terrainChange      Boolean?                 @default(false)
  displacement       Float?
  historicalActivity Float?
  source             String                   @default("DEMO")
  description        String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  location           Location?                @relation(fields: [locationId], references: [id])

  @@index([locationId])
  @@index([eventDate])
  @@index([severity])
  @@index([source])
}

model Prediction {
  id                String    @id @default(uuid())
  locationId        String
  riskScore         Int
  riskLevel         RiskLevel
  confidence        Float     @default(0.0)
  explanation       String
  createdAt         DateTime  @default(now())
  baselineRiskScore Int       @default(0)
  expiresAt         DateTime?
  featureImportance Json?
  features          Json?
  generatedAt       DateTime  @default(now())
  horizon           String    @default("24H")
  mlProbability     Float     @default(0.0)
  modelName         String    @default("VELTREX-DEMO-V1")
  modelVersion      String    @default("1.0.0")
  predictionSource  String    @default("DEMO_MODEL")
  probability       Float     @default(0.0)
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([horizon])
  @@index([riskLevel])
  @@index([riskScore])
  @@index([generatedAt])
}

model Infrastructure {
  id           String                   @id @default(uuid())
  name         String
  type         InfraType
  locationId   String
  latitude     Float
  longitude    Float
  locationGeom Unsupported("geometry")?
  status       String                   @default("OPERATIONAL")
  createdAt    DateTime                 @default(now())
  location     Location                 @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([type])
}

model SimulationRun {
  id                 String    @id @default(uuid())
  scenarioId         String
  locationId         String?
  status             String    @default("COMPLETED")
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  initialRisk        Int       @default(42)
  finalRisk          Int       @default(78)
  initialProbability Float     @default(0.58)
  finalProbability   Float     @default(0.81)
  finalAlertLevel    String    @default("WARNING")
  finalPriority      String    @default("P1")
  source             String    @default("DEMO")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([scenarioId])
  @@index([locationId])
  @@index([status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  ADMIN
  DISTRICT_AUTHORITY
  FIELD_OFFICER
  COMMUNITY_USER
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum SensorType {
  RAINFALL
  SOIL_MOISTURE
  SLOPE
  TILT
  VIBRATION
  DISPLACEMENT
}

enum SensorStatus {
  ONLINE
  OFFLINE
  WARNING
  MAINTENANCE
}

enum SatelliteObsType {
  SAR
  OPTICAL
  TERRAIN_CHANGE
  DISPLACEMENT
}

enum Severity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  DISPATCHED
  RESOLVED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AlertLanguage {
  EN
  HI
  AS
  BN
  MNI
  MIZO
  KHASI
  NEPALI
}

enum AlertChannel {
  SMS
  PUSH
  VOICE
  APP
}

enum AlertStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  EXPIRED
  CANCELLED
}

enum InfraType {
  ROAD
  BRIDGE
  HOSPITAL
  SCHOOL
  EMERGENCY_CENTER
  CRITICAL_FACILITY
}

enum FieldReportType {
  LANDSLIDE
  CRACK
  ROCKFALL
  ROAD_BLOCKAGE
  SLOPE_FAILURE
  FLOODING
  DRAINAGE_FAILURE
  OTHER
}

enum FieldReportStatus {
  SUBMITTED
  RECEIVED
  REVIEWING
  VERIFIED
  REJECTED
  RESOLVED
}

enum AiVerificationStatus {
  NOT_PROCESSED
  PROCESSING
  VERIFIED
  FLAGGED
  UNAVAILABLE
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum AlertLevel {
  ADVISORY
  WATCH
  WARNING
  EMERGENCY
}

enum AlertPriority {
  P4
  P3
  P2
  P1
}

enum AlertTriggerType {
  RISK_THRESHOLD
  ML_PREDICTION
  FIELD_REPORT
  RAPID_ESCALATION
  MANUAL
}

enum AlertSource {
  DEMO
  SYSTEM
  AUTHORITY
}
