# VELTREX Environment Variables Template

# Frontend Base Configurations
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_WS_URL=http://localhost:5000

# Backend Server & Database Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=

# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/veltrex_db?schema=public

# Real Weather Provider Settings (OpenWeather)
WEATHER_PROVIDER=openweather
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_CACHE_MINUTES=30

# Real Satellite Earth Observation Settings (Sentinel Hub)
SATELLITE_PROVIDER=sentinel-hub
SATELLITE_API_BASE_URL=https://services.sentinel-hub.com/api/v1
SATELLITE_CLIENT_ID=
SATELLITE_CLIENT_SECRET=
SATELLITE_CACHE_MINUTES=60
SATELLITE_SEARCH_RADIUS_KM=10

# Alert & Real-time Settings
ALERT_DEDUP_WINDOW_MINUTES=60
REALTIME_ENABLED=true
SIMULATION_DEFAULT_SPEED=NORMAL
MEDIA_STORAGE_PROVIDER=LOCAL
